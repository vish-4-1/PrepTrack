# --- Server & Security ---
NODE_ENV=development
PORT=5000
DATABASE_URL="postgresql://user:password@localhost:5432/preptrack?schema=public"
JWT_SECRET="replace-with-64-char-cryptographic-secret"
JWT_EXPIRES_IN="7d"
CORS_ORIGINS="http://localhost:5173,https://preptrack.vercel.app"

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --- AI & Agent Configuration (Groq / Gemini / OpenAI Compatible) ---
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_API_KEY="your-llm-api-key"
LLM_MODEL="llama-3.3-70b-versatile"
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
AGENT_MAX_ITERATIONS=5

# --- External Profile Connectors ---
GITHUB_API_URL="https://api.github.com"
GITHUB_TOKEN=""
LEETCODE_GRAPHQL_URL="https://leetcode.com/graphql"
CODECHEF_BASE_URL="https://www.codechef.com"
HACKERRANK_API_URL="https://www.hackerrank.com/rest/contests/master"
CONNECTOR_TIMEOUT_MS=10000

# --- Frontend (Vite) ---
VITE_API_URL="http://localhost:5000/api"
VITE_APP_NAME="PrepTrack"
